{
  "name": "@masonchow/pi-hud",
  "version": "0.1.1",
  "description": "Pi extension: Claude Code style HUD statusline — model, context usage, cost, cache hit rate, subagents, opencode-go quota",
  "type": "module",
  "license": "MIT",
  "author": "MasonChow",
  "homepage": "https://github.com/MasonChow/pi-hub/tree/main/pi-hud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasonChow/pi-hub.git",
    "directory": "pi-hud"
  },
  "bugs": "https://github.com/MasonChow/pi-hub/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "hud",
    "statusline",
    "usage"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
