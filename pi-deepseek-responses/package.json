{
  "name": "@masonchow/pi-deepseek-responses",
  "version": "0.2.0",
  "description": "Pi extension: route the official DeepSeek provider through Responses API with native server-side web search and automatic vision-model switching",
  "type": "module",
  "license": "MIT",
  "author": "MasonChow",
  "homepage": "https://github.com/MasonChow/pi-hub/tree/main/pi-deepseek-responses#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasonChow/pi-hub.git",
    "directory": "pi-deepseek-responses"
  },
  "bugs": "https://github.com/MasonChow/pi-hub/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "deepseek",
    "responses-api",
    "web-search",
    "vision"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
