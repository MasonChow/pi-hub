{
  "name": "@masonchow/pi-otel",
  "version": "0.1.0",
  "description": "Pi extension: OpenTelemetry reporting core — traces, metrics, and logs for sessions, turns, LLM requests, tools, and human interventions",
  "type": "module",
  "license": "MIT",
  "author": "MasonChow",
  "homepage": "https://github.com/MasonChow/pi-hub/tree/main/pi-otel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasonChow/pi-hub.git",
    "directory": "pi-otel"
  },
  "bugs": "https://github.com/MasonChow/pi-hub/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "opentelemetry",
    "otel",
    "observability"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
